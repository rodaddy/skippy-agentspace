#!/usr/bin/env sh
# Call Proxmox MCP tools through LiteLLM REST gateway
# Usage: pve-call <tool_name> [json_args]
#
# Examples:
#   pve-call get_nodes
#   pve-call get_containers '{"payload":{}}'
#   pve-call start_container '{"selector":"215"}'

TOOL="$1"
ARGS="${2:-"{}"}"

if [ -z "$TOOL" ]; then
  echo "Usage: pve-call <tool_name> [json_args]" >&2
  exit 1
fi

# Load config from .env
ENV_FILE="$(dirname "$0")/.env"
if [ -f "$ENV_FILE" ]; then
  . "$ENV_FILE"
else
  echo "Error: Missing .env file at $ENV_FILE" >&2
  exit 1
fi

PAYLOAD=$(printf '{"name":"%s","arguments":%s,"server_id":"%s"}' "$TOOL" "$ARGS" "$PROXMOX_SERVER_ID")

curl -s -X POST \
  -H "Authorization: Bearer ${LITELLM_API_KEY}" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD" \
  "${LITELLM_URL}/mcp-rest/tools/call"
