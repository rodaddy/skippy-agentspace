#!/usr/bin/env bash
# pdf-preview - Render PDF page to image for visual verification
# Usage: pdf-preview <pdf-path> [page-number]

set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: pdf-preview <pdf-path> [page-number]"
    echo "Renders PDF page to PNG image for visual verification"
    echo "Default page: 1"
    exit 1
fi

PDF_PATH="$1"
PAGE_NUM="${2:-1}"

if [[ ! -f "$PDF_PATH" ]]; then
    echo "Error: File not found: $PDF_PATH"
    exit 1
fi

# Check for pdftoppm (from poppler)
if ! command -v pdftoppm &> /dev/null; then
    echo "Error: pdftoppm not found. Install with: brew install poppler"
    exit 1
fi

# Generate unique filename based on input
BASENAME=$(basename "$PDF_PATH" .pdf)
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
OUTPUT_DIR="/tmp/pdf-preview"
mkdir -p "$OUTPUT_DIR"

OUTPUT_BASE="$OUTPUT_DIR/${BASENAME}-${TIMESTAMP}"

# Render single page to PNG at 150 DPI (good balance of quality/size)
pdftoppm -png -f "$PAGE_NUM" -l "$PAGE_NUM" -r 150 "$PDF_PATH" "$OUTPUT_BASE"

# Find the generated file (pdftoppm adds page number suffix)
OUTPUT_FILE=$(ls -1 "${OUTPUT_BASE}"*.png 2>/dev/null | head -1)

if [[ -n "$OUTPUT_FILE" && -f "$OUTPUT_FILE" ]]; then
    echo "✓ Preview generated: $OUTPUT_FILE"
    echo ""
    echo "View with: open \"$OUTPUT_FILE\""
    echo "Or use Claude's Read tool to view the image"
else
    echo "Error: Failed to generate preview"
    exit 1
fi
