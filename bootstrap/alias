# -- Paperclip agent management --

# Kick a routine by name fragment: pkick myapp, pkick deploy, pkick standup
pkick() {
  local q="${1:?Usage: pkick <name-fragment>}"
  local match=$(curl -s "$PAPERCLIP_URL/api/companies/__YOUR_PAPERCLIP_COMPANY_ID__/routines" \
    | python3 -c "
import sys,json
data=json.load(sys.stdin)
routines=data if isinstance(data,list) else data.get('routines',data.get('data',[]))
q='$q'.lower()
for r in routines:
    if q in r.get('title','').lower():
        print(r['id'],r['title']); break
")
  if [ -z "$match" ]; then echo "No routine matching '$q'"; return 1; fi
  local rid=$(echo "$match" | cut -d' ' -f1)
  local title=$(echo "$match" | cut -d' ' -f2-)
  echo "Kicking: $title"
  curl -s -X POST "$PAPERCLIP_URL/api/routines/$rid/run" \
    -H "Content-Type: application/json" -d '{"source":"manual"}' | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'  -> {d.get(\"status\",d.get(\"id\",\"ok\"))}')" 2>/dev/null
}

# Kick all routines: pkickall
pkickall() {
  curl -s "$PAPERCLIP_URL/api/companies/__YOUR_PAPERCLIP_COMPANY_ID__/routines" \
    | python3 -c "
import sys,json
data=json.load(sys.stdin)
routines=data if isinstance(data,list) else data.get('routines',data.get('data',[]))
for r in routines:
    print(r['id'],r['title'])
" | while read -r rid title; do
    echo "Kicking: $title"
    curl -s -X POST "$PAPERCLIP_URL/api/routines/$rid/run" \
      -H "Content-Type: application/json" -d '{"source":"manual"}' > /dev/null
  done
  echo "All routines kicked."
}

# Wake an agent by name fragment: pwake cto, pwake "tax master"
pwake() {
  local q="${1:?Usage: pwake <name-fragment>}"
  local match=$(curl -s "$PAPERCLIP_URL/api/companies/__YOUR_PAPERCLIP_COMPANY_ID__/agents" \
    | python3 -c "
import sys,json
data=json.load(sys.stdin)
agents=data if isinstance(data,list) else data.get('agents',data.get('data',[]))
q='$q'.lower()
for a in agents:
    if q in a.get('name','').lower():
        print(a['id'],a['name']); break
")
  if [ -z "$match" ]; then echo "No agent matching '$q'"; return 1; fi
  local aid=$(echo "$match" | cut -d' ' -f1)
  local name=$(echo "$match" | cut -d' ' -f2-)
  echo "Waking: $name"
  curl -s -X POST "$PAPERCLIP_URL/api/agents/$aid/heartbeat/invoke" \
    -H "Content-Type: application/json" | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'  -> {d.get(\"status\",\"queued\")}')" 2>/dev/null
}

# Wake all agents: pwakeall
pwakeall() {
  curl -s "$PAPERCLIP_URL/api/companies/__YOUR_PAPERCLIP_COMPANY_ID__/agents" \
    | python3 -c "
import sys,json
data=json.load(sys.stdin)
agents=data if isinstance(data,list) else data.get('agents',data.get('data',[]))
for a in agents:
    if a.get('status') != 'terminated':
        print(a['id'],a['name'])
" | while read -r aid name; do
    echo "Waking: $name"
    curl -s -X POST "$PAPERCLIP_URL/api/agents/$aid/heartbeat/invoke" \
      -H "Content-Type: application/json" > /dev/null
  done
  echo "All agents woken."
}

# Quick agent status: pstatus
pstatus() {
  curl -s "$PAPERCLIP_URL/api/companies/__YOUR_PAPERCLIP_COMPANY_ID__/agents" \
    | python3 -c "
import sys,json
data=json.load(sys.stdin)
agents=data if isinstance(data,list) else data.get('agents',data.get('data',[]))
for a in sorted(agents, key=lambda x: x['name']):
    hb=a.get('lastHeartbeatAt','never')
    if hb and hb!='never': hb=hb[5:16]
    print(f'{a[\"name\"]:<25} {a[\"status\"]:<12} last:{hb}')
"
}
