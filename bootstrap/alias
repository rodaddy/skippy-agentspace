# iTerm2 profile switching for CC sessions
# Reads ~/.config/pai/iterm-profiles.json for project-to-profile mapping
# Disable with: export PAI_ITERM_PROFILES=0
_cc_set_profile() {
    [[ "$PAI_ITERM_PROFILES" == "0" ]] && return
    local config="$HOME/.config/pai/iterm-profiles.json"
    [[ ! -f "$config" ]] && return
    local dir=$(basename "$PWD" | tr '[:upper:]' '[:lower:]')
    local profile=$(jq -r --arg d "$dir" '.projects[$d] // .default // "Blue_boy"' "$config" 2>/dev/null)
    iterm2_profile "$profile"
}

# WARNING: Disables ALL Claude permission prompts. Remove for default safety behavior.
_cc_launch() {
    local old="${ITERM_PROFILE:-Blue_boy}"
    _cc_set_profile
    claude --dangerously-skip-permissions "$@"
    iterm2_profile "$old"
}

# WARNING: Disables ALL Claude permission prompts. Remove for default safety behavior.
# Bare claude always gets --dangerously-skip-permissions
claude() { command claude --dangerously-skip-permissions "$@"; }

# Default launchers (via LiteLLM)
unalias cc cco ccs cch ccg ccgf ccg2 2>/dev/null
cc()  { _cc_launch "$@"; }
cco() { _cc_launch --model opus "$@"; }
ccs() { _cc_launch --model sonnet "$@"; }
cch() { _cc_launch --model haiku "$@"; }

# Gemini models via LiteLLM
ccg()  { _cc_launch --model gemini-3-pro "$@"; }
ccgf() { _cc_launch --model gemini-3-flash "$@"; }
ccg2() { _cc_launch --model gemini-2.5-pro "$@"; }

# tmux-wrapped -- protects scrollback from Ink renderer clearing
tclaude() {
    local session_name="claude-${PWD##*/}"
    if [[ -n "$TMUX" ]]; then
        _cc_launch "$@"
        return
    fi
    if tmux has-session -t "$session_name" 2>/dev/null; then
        tmux attach -t "$session_name"
    else
        tmux new-session -s "$session_name" "zsh -ic '_cc_launch $*; exec zsh'"
    fi
}

# Direct Vertex AI -- bypasses LiteLLM, uses Google Cloud auth directly
# WARNING: Disables ALL Claude permission prompts. Remove for default safety behavior.
vclaude() {
    local old="${ITERM_PROFILE:-Blue_boy}"
    _cc_set_profile
    (
        unset ANTHROPIC_BASE_URL ANTHROPIC_API_KEY
        export CLAUDE_CODE_USE_VERTEX=1
        export CLOUD_ML_REGION=global
        export ANTHROPIC_VERTEX_PROJECT_ID="__YOUR_GCP_PROJECT_ID__"
        export ANTHROPIC_MODEL="claude-opus-4-6@default[1M]"
        claude --dangerously-skip-permissions "$@"
    )
    iterm2_profile "$old"
}

# Model switcher function - use: ccm gemini-3-flash
ccm() {
    if [[ -z "$1" ]]; then
        echo "Available models:"
        echo "  Claude:  opus, sonnet, haiku"
        echo "  Gemini:  gemini-3-pro, gemini-3-flash, gemini-2.5-pro, gemini-2.5-flash"
        echo "  Vertex:  vclaude (direct Vertex AI, no LiteLLM)"
        echo ""
        echo "Usage: ccm <model-name>"
        return
    fi
    _cc_launch --model "$1"
}

