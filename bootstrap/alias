# ============================================
# Claude Code Worktree Sessions (Boris pattern)
# ============================================
# Parallel isolated sessions -- each gets its own worktree + branch
# cw "name"  = launch Claude in a named worktree
# cwa/cwb/cwc = quick-switch aliases for up to 3 parallel sessions
# cwanalysis = permanent read-only analysis worktree (logs, queries, debugging)

cw() {
    local name="${1:-$(date +%s | shasum | head -c 6)}"
    _cc_launch --worktree "$name" "${@:2}"
}
cwa() { cw "session-a" "$@"; }
cwb() { cw "session-b" "$@"; }
cwc() { cw "session-c" "$@"; }

# Permanent analysis worktree -- never gets dirty with implementation
cwanalysis() {
    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ -z "$repo_root" ]]; then
        echo "Not in a git repo"
        return 1
    fi
    local wt_path="$repo_root/.claude/worktrees/analysis"
    if [[ ! -d "$wt_path" ]]; then
        git worktree add "$wt_path" HEAD --detach
        echo "Created analysis worktree at $wt_path"
    fi
    (cd "$wt_path" && _cc_launch "$@")
}

