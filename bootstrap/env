# ============================================
# PATH DEDUPLICATION FUNCTION
# ============================================
deduplicate_path() {
    local path_var="$1"
    local new_path=""
    local old_ifs="$IFS"
    IFS=':'

    # Handle zsh vs bash array expansion differences
    if [[ -n "$ZSH_VERSION" ]]; then
        # Zsh version - split on colons manually
        local -a path_array
        path_array=("${(@s/:/)${(P)path_var}}")
        for dir in "${path_array[@]}"; do
            if [[ ! "$new_path" =~ (^|:)"$dir"(:|$) ]] && [[ -n "$dir" ]]; then
                if [[ -z "$new_path" ]]; then
                    new_path="$dir"
                else
                    new_path="$new_path:$dir"
                fi
            fi
        done
    else
        # Bash version - use eval (compatible with bash 3.2 on macOS; local -n requires 4.3+)
        local path_ref
        eval "path_ref=\"\$$path_var\""
        local -a path_array
        IFS=':' read -ra path_array <<< "$path_ref"
        for dir in "${path_array[@]}"; do
            if [[ ! "$new_path" =~ (^|:)"$dir"(:|$) ]] && [[ -n "$dir" ]]; then
                if [[ -z "$new_path" ]]; then
                    new_path="$dir"
                else
                    new_path="$new_path:$dir"
                fi
            fi
        done
    fi

    IFS="$old_ifs"
    eval "export $path_var=\"$new_path\""
}

