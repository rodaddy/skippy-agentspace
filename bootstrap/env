# OPTIMIZED: Fabric pattern aliases (cached to save ~1.0s startup time)
# Regenerates only when patterns directory changes
FABRIC_ALIASES_CACHE="$HOME/.cache/fabric_aliases.zsh"

if [[ ! -f "$FABRIC_ALIASES_CACHE" ]] || \
   [[ "$HOME/.config/fabric/patterns" -nt "$FABRIC_ALIASES_CACHE" ]]; then

    mkdir -p "$(dirname "$FABRIC_ALIASES_CACHE")"
    > "$FABRIC_ALIASES_CACHE"  # Clear file

    for pattern_file in $HOME/.config/fabric/patterns/*; do
        pattern_name="$(basename "$pattern_file")"
        alias_name="${FABRIC_ALIAS_PREFIX:-}${pattern_name}"
        echo "alias $alias_name='fabric --pattern $pattern_name'" >> "$FABRIC_ALIASES_CACHE"
    done
fi

