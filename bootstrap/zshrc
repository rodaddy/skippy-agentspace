# Lazy load pyenv (saves ~150ms - loads on first python/pyenv call)
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
# Must unalias before defining functions (alias comes from ~/.alias)
unalias python python3 pythonw 2>/dev/null
_lazy_pyenv_init() {
  if [[ -n "$_PYENV_INITIALIZED" ]]; then return; fi
  export _PYENV_INITIALIZED=1
  unset -f pyenv python python3 2>/dev/null
  eval "$(command pyenv init -)"
}
pyenv() { _lazy_pyenv_init; command pyenv "$@"; }
python() { _lazy_pyenv_init; command python "$@"; }
python3() { _lazy_pyenv_init; command python3 "$@"; }

# Only load zoxide in interactive shells (fixes Claude Code Bash tool)
